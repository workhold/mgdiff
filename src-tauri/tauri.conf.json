{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MGDiff",
  "version": "0.2.1",
  "identifier": "com.mgdiff.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MGDiff",
        "width": 1480,
        "height": 940,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#f8fafc"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
